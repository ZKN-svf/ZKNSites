{
  "name": "zknsites",
  "private": true,
  "version": "1.0.0",
  "description": "ZKNSites — plataforma SaaS de criação e publicação de sites na Cloudflare",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@zknsites/builder && npm run build --workspace=@zknsites/publisher",
    "build:app": "node scripts/build-app.mjs",
    "dev:api": "wrangler dev --config apps/builder/wrangler.toml",
    "deploy:api": "wrangler deploy --config apps/builder/wrangler.toml",
    "deploy:publisher": "wrangler deploy --config apps/publisher/wrangler.toml",
    "db:migrate": "wrangler d1 migrations apply zknsites-db --remote"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
